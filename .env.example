# Copy to ".env.local" for local development. On Firebase, set these in apphosting.yaml (see DEPLOY.md).

# Admin login (the browser stays logged in for a year)
ADMIN_USER=sonia
ADMIN_PASSWORD=titourita
# SESSION_SECRET=   # optional; derived from the credentials when empty

# Storage — leave empty locally to use the ./data folder.
# STORAGE_BACKEND=firebase            # firebase | supabase | local
# FIREBASE_STORAGE_BUCKET=my-project.firebasestorage.app
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=...

# Optional: e-mail for every new order
# ORDER_EMAIL_TO=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
